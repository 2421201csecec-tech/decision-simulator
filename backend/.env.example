APP_ENV=development
LOG_LEVEL=INFO
PORT=8000

# Local dev uses SQLite (no Postgres needed)
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Supabase direct connection (recommended — full prepared statement caching):
# DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@[PROJECT_REF].supabase.co:5432/postgres

# Supabase pooler / PgBouncer transaction mode (higher concurrency limit):
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
