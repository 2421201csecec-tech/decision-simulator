APP_ENV=development
LOG_LEVEL=INFO
PORT=8000

# LLM (Groq free tier for dev — swap to Anthropic in prod)
GROQ_API_KEY=gsk_...
LLM_PRIMARY_MODEL=llama-3.3-70b-versatile
LLM_FALLBACK_MODEL=llama-3.1-8b-instant
LLM_TIMEOUT_SECONDS=25

# Extraction
PROMPT_VERSION=1.1.0
MAX_RETRIES_PER_PASS=2
MIN_VARIABLES_THRESHOLD=3
MAX_VARIABLES_ALLOWED=15
MIN_CONFIDENCE_FOR_STORAGE=0.70
CLARIFICATION_ENABLED=true
ENRICHMENT_ENABLED=true
MEMORY_WRITE_ENABLED=true

# Local dev uses SQLite (no Postgres needed)
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Supabase direct connection (recommended — full prepared statement caching):
# DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@[PROJECT_REF].supabase.co:5432/postgres

# Supabase pooler / PgBouncer transaction mode (higher concurrency limit):
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
